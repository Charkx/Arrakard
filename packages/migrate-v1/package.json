{
  "name": "@arrakis/migrate-v1",
  "version": "0.0.0",
  "private": true,
  "description": "Migration unique des données v1 vers le schéma v2. Supprimable après la bascule.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
