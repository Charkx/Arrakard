{
  "name": "arrakis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc -p tools/tsconfig.json",
    "test": "pnpm -r test",
    "coverage": "pnpm -r coverage",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm coverage",
    "dev": "pnpm --filter @arrakis/web dev",
    "build": "pnpm --filter @arrakis/web build",
    "size": "pnpm --filter @arrakis/web size",
    "golden-master:extract": "tsx tools/golden-master/extract-v1.ts",
    "db:start": "supabase start -x gotrue,realtime,storage-api,imgproxy,mailpit,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "test:db": "supabase test db && pnpm --filter @arrakis/migrate-v1 test:db && pnpm --filter @arrakis/migrate-v1 load demo-backup --replace && pnpm --filter @arrakis/web test:db"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
