{
  "name": "@arrakis/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Le serveur d'Arrakis, en trois couches : domaine, application, infrastructure (ADR 0023, ADR 0025).",
  "type": "module",
  "exports": {
    "./domain": "./src/domain/index.ts",
    "./application": "./src/application/index.ts",
    "./infrastructure": "./src/infrastructure/index.ts",
    "./contracts": "./src/contracts/index.ts"
  },
  "imports": {
    "#contracts/*": "./src/contracts/*",
    "#domain/*": "./src/domain/*",
    "#application/*": "./src/application/*",
    "#infrastructure/*": "./src/infrastructure/*",
    "#support/*": "./tests/support/*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.pure.json",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "postgres": "3.4.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  }
}
