{
  "name": "@arrakis/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Le serveur d'Arrakis, en trois couches : domaine, application, infrastructure (ADR 0023, ADR 0025).",
  "type": "module",
  "exports": {
    "./domain": "./domain/index.ts",
    "./application": "./application/index.ts",
    "./application/testing": "./application/testing/index.ts",
    "./infrastructure": "./infrastructure/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.pure.json",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "postgres": "^4.1.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  }
}
