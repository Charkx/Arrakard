{
  "name": "@arrakis/web",
  "version": "0.0.0",
  "private": true,
  "description": "Le site d'Arrakis : il affiche et envoie des commandes, il ne calcule rien qu'il enregistre.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "size": "node scripts/bundle-size.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@arrakis/domain": "workspace:*",
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@arrakis/migrate-v1": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.7",
    "vitest": "^5.0.3"
  }
}
