{
  // Masque dans l'explorateur ce que git ignore et qu'on n'ouvre jamais :
  // les traces de l'agent, les rapports de couverture, les builds, les caches.
  "files.exclude": {
    "**/.claude/.cc-writes": true,
    "**/coverage": true,
    "**/dist": true,
    "**/.DS_Store": true,
    "supabase/.temp": true,
    "supabase/.branches": true
  }
}
